    <CanUnloadAsync>true</CanUnloadAsync>
    <AcceptsFeedback>false</AcceptsFeedback>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/StageManager.Core.csproj" /></ItemGroup>
</Project>
