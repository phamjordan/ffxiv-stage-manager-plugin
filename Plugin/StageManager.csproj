<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.4</Version>
    <Author>Stage Manager</Author>
    <Name>Stage Manager</Name>
    <Punchline>Rehearsal positions, local ghosts, and emote cues.</Punchline>
    <Description>Connect FFXIV Stage Manager to local rehearsal ghosts. Windows prototype; native ghosts await in-game validation.</Description>
